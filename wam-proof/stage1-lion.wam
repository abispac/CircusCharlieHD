model stage1_lion
  height 1.22
  style fine

palette
  hide       #c98a2c
  hide_light #e7b55a
  mane       #7a3d12
  mane_dark  #4b250d
  muzzle     #e2c38a
  nose       #21150f
  eye        #e8b23d
  pupil      #17110d

skeleton
  root pelvis at (0,0.58,-0.18)
  bone spine parent=pelvis dir=fwd pitch=3 len=0.30
  bone chest parent=spine dir=fwd pitch=-4 len=0.24
  bone neck parent=chest at=0.82 up=0.05 dir=up pitch=64 len=0.17
  bone skull parent=neck dir=fwd pitch=-12 len=0.17
  bone muzzle parent=skull at=0.62 up=-0.01 dir=fwd pitch=-4 len=0.14
  bone jaw parent=muzzle at=0.42 up=-0.035 dir=fwd pitch=-2 len=0.11
  bone tail1 parent=pelvis at=0.08 up=0.04 dir=back pitch=-8 len=0.28
  bone tail2 parent=tail1 dir=back pitch=-17 len=0.25
  bone tail3 parent=tail2 dir=back pitch=31 len=0.18
  bone tailtip parent=tail3 dir=up pitch=-24 len=0.10
  mirror
    bone rear_upper parent=pelvis at=0.35 side=0.13 dir=down pitch=-18 len=0.27
    bone rear_lower parent=rear_upper dir=down pitch=21 len=0.25
  bone rear_paw parent=rear_lower dir=fwd pitch=-38 len=0.15
    bone front_upper parent=chest at=0.65 side=0.13 dir=down pitch=9 len=0.30
    bone front_lower parent=front_upper dir=down pitch=-8 len=0.25
  bone front_paw parent=front_lower dir=fwd pitch=-42 len=0.15
    bone ear parent=skull at=0.30 side=0.075 up=0.07 dir=up tilt=11 pitch=-8 len=0.085
  end

parts
  loft torso bones=pelvis..chest frame=up material=hide
    ring 0.00 w=0.42 dtop=0.24 dbot=0.29
    ring 0.28 w=0.47 dtop=0.27 dbot=0.31
    ring 0.72 w=0.45 dtop=0.30 dbot=0.31
    ring 1.00 w=0.34 dtop=0.27 dbot=0.25
    cap start=dome end=dome

  loft neck_mass bones=chest..neck frame=side material=mane
    ring 0.00 w=0.40 d=0.38
    ring 0.62 w=0.38 d=0.40
    ring 1.00 w=0.29 d=0.32
    cap start=dome end=dome

  loft head bones=neck..skull frame=up material=mane
    ring 0.00 w=0.31 d=0.33
    ring 0.48 w=0.33 d=0.35
    ring 1.00 w=0.25 d=0.27 material=hide
    cap start=dome end=dome

  loft face bones=skull..muzzle frame=up material=hide_light
    ring 0.00 w=0.23 d=0.24
    ring 0.55 w=0.20 d=0.20
    ring 1.00 w=0.15 d=0.13 material=muzzle
    cap start=dome end=dome

  loft lower_muzzle bones=muzzle..jaw frame=up material=muzzle
    ring 0.00 w=0.15 d=0.11
    ring 1.00 w=0.12 d=0.07
    cap start=dome end=dome

  attach nose bone=muzzle at=1.0 offset=(0,0.005,0.012) kind=sphere w=0.115 h=0.08 d=0.065 material=nose
  mirror
    attach eye_white bone=skull at=0.76 offset=(0.135,0.055,0.015) kind=eye size=0.048 material=muzzle
    attach iris bone=skull at=0.78 offset=(0.163,0.055,0.028) kind=eye size=0.025 material=eye
    attach pupil_part bone=skull at=0.79 offset=(0.178,0.055,0.036) kind=eye size=0.013 material=pupil
    loft ear_shape bones=ear..ear frame=fwd material=hide
      ring 0.00 w=0.09 d=0.035
      ring 1.00 w=0.025 d=0.015 tip
      cap start=dome end=point
  end

  mirror
    loft rear_leg bones=rear_upper..rear_paw frame=fwd material=hide
      ring 0.00 w=0.17 d=0.18
      ring 0.42 w=0.14 d=0.15
      ring 0.66 w=0.10 d=0.11
      ring 0.88 w=0.11 d=0.09
      ring 1.00 w=0.15 d=0.075
      cap start=dome end=dome
    loft front_leg bones=front_upper..front_paw frame=fwd material=hide
      ring 0.00 w=0.15 d=0.16
      ring 0.45 w=0.115 d=0.12
      ring 0.66 w=0.09 d=0.095
      ring 0.88 w=0.10 d=0.08
      ring 1.00 w=0.15 d=0.07
      cap start=dome end=dome
  end

  sweep tail bones=tail1..tailtip material=hide
    seg len=0.22 r=0.055
    seg len=0.20 r=0.045 up=5
    seg len=0.16 r=0.035 up=12
    seg len=0.12 r=0.025 up=20 tip

  attach tail_tuft bone=tailtip at=0.92 kind=sphere w=0.13 h=0.14 d=0.11 material=mane_dark

textures
  texture hide base=#c98a2c
    gradient axis=v from=-0.10 to=0.16
    noise scale=0.055 amount=0.08
    streaks along=v amount=0.06
    ao amount=0.12
  texture hide_light base=#e7b55a
    gradient axis=v from=-0.06 to=0.12
    noise scale=0.045 amount=0.05
    ao amount=0.10
  texture mane base=#7a3d12
    gradient axis=v from=-0.14 to=0.10
    noise scale=0.040 amount=0.16
    streaks along=v amount=0.15
    ao amount=0.18
  texture mane_dark base=#4b250d
    noise scale=0.035 amount=0.14
    streaks along=v amount=0.16
  texture muzzle base=#e2c38a
    gradient axis=v from=-0.04 to=0.10
    noise scale=0.035 amount=0.035
    ao amount=0.08

animations
  anim arcade_walk loop dur=0.72
    ch rear_upper.l pitch 0%=-24 16.7%=-9 33.3%=15 50%=27 66.7%=10 83.3%=-13 100%=-24
    ch rear_lower.l pitch 0%=17 16.7%=5 33.3%=-7 50%=4 66.7%=28 83.3%=34 100%=17
    ch rear_paw.l pitch 0%=-10 16.7%=-5 33.3%=7 50%=11 66.7%=-8 83.3%=-16 100%=-10
    ch front_upper.l pitch 0%=25 16.7%=8 33.3%=-13 50%=-23 66.7%=-6 83.3%=15 100%=25
    ch front_lower.l pitch 0%=2 16.7%=25 33.3%=33 50%=15 66.7%=3 83.3%=-5 100%=2
    ch front_paw.l pitch 0%=8 16.7%=-6 33.3%=-14 50%=-7 66.7%=5 83.3%=12 100%=8
    ch pelvis pitch 0%=1.5 25%=-1 50%=1.5 75%=-1 100%=1.5
    ch neck pitch 0%=-1.5 25%=1 50%=-1.5 75%=1 100%=-1.5
    ch skull pitch 0%=1 25%=-0.5 50%=1 75%=-0.5 100%=1
    ch tail1 pitch 0%=5 25%=-4 50%=5 75%=-4 100%=5
    ch tail2 pitch 0%=-6 25%=4 50%=-6 75%=4 100%=-6
    mirrorphase 50%

checks
  assert tris < 9000
  assert bottom(front_leg.l) < 0.08
  assert bottom(rear_leg.l) < 0.08
  assert zmax(face) > zmax(torso)
  assert influences(front_leg.l) >= 2
  assert influences(rear_leg.l) >= 2
  assert lowest(arcade_walk) > -0.08
